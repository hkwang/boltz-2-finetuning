#!/usr/bin/env bash
#PBS -N agent
#PBS -A GenesisHackathonOct26
#PBS -q R7728155
#PBS -l select=1:ngpus=4
#PBS -l walltime=08:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
# One Codex agent with its own clone and its own 4xA100 node, run unsandboxed (full access) on /eagle.
# Submit through experiments/spawn_agent.sh, which sets AGENT and the paths below and writes the brief to agents/<name>/brief.txt.
# Compute nodes have no direct internet: the agent reaches the model provider (mag in ~/.codex/config.toml) through the ALCF proxy.
set -euo pipefail

: "${AGENT:?}" "${SWARM_ROOT:?}"
BRIEF="$(cat "$SWARM_ROOT/agents/$AGENT/brief.txt")"
workdir="$SWARM_ROOT/agents/$AGENT/repo"
cd "$workdir"

source ~/.bashrc >/dev/null 2>&1
: "${AMSC_TOKEN:?AMSC_TOKEN is not set by ~/.bashrc}"
export HTTPS_PROXY=http://proxy.alcf.anl.gov:3128 HTTP_PROXY=http://proxy.alcf.anl.gov:3128
export https_proxy=$HTTPS_PROXY http_proxy=$HTTP_PROXY NO_PROXY=localhost,127.0.0.1,.alcf.anl.gov no_proxy=localhost,127.0.0.1,.alcf.anl.gov
export SWARM_ROOT AGENT
export PATH="$VENV_DIR/bin:$PATH"

module load cray-python/3.12.12
module load cuda/12.9
source "$VENV_DIR/bin/activate"
export CC=gcc PYTHONPATH="$workdir/src"

deadline="$(date -u -d "+${AGENT_HOURS:-7} hours" +%Y-%m-%dT%H:%M:%SZ)"
python experiments/board.py register --agent "$AGENT" --brief "$BRIEF" --deadline "$deadline"

prompt="You are agent '$AGENT'. Read $workdir/docs/swarm.md now and follow it exactly. Your brief: $BRIEF. Your hard deadline is $deadline; stop starting new training after $(date -u -d "+$(( ${AGENT_HOURS:-7} - 1 )) hours" +%H:%MZ) and make sure every finished candidate is posted to the board before the deadline."

log="$SWARM_ROOT/agents/$AGENT/codex.log"
codex exec -c model_provider=mag -c "model=${AGENT_MODEL:-gpt-6.1-sol}" -c model_reasoning_effort=high \
    --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check -C "$workdir" "$prompt" 2>&1 | tee -a "$log"
