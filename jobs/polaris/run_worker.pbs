#!/usr/bin/env bash
#PBS -N worker
#PBS -A GenesisHackathonOct26
#PBS -q R7728155
#PBS -l select=1:ngpus=4
#PBS -l walltime=08:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
# Holds one 4xA100 node for an agent and runs the shell commands the agent queues from its laptop (swarm/polaris.sh run).
# Submit through experiments/spawn_agent.sh. Queue: $SWARM_ROOT/agents/$AGENT/queue/<id>.sh; logs: logs/<id>.log, logs/<id>.exit.
# Commands run one at a time in the agent's repo clone with the Boltz environment active. Create agents/$AGENT/stop to end the worker early.
set -uo pipefail

: "${AGENT:?}" "${SWARM_ROOT:?}" "${VENV_DIR:?}"
agent_dir="$SWARM_ROOT/agents/$AGENT"
repo="$agent_dir/repo"
mkdir -p "$agent_dir"/{queue,running,done,logs}
cd "$repo"

module load cray-python/3.12.12
module load cuda/12.9
source "$VENV_DIR/bin/activate"
export CC=gcc PYTHONPATH="$repo/src" SWARM_ROOT AGENT OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 PYTHONUNBUFFERED=1

end=$(( $(date +%s) + ${WORKER_SECONDS:-27000} ))
echo "worker for $AGENT on $(hostname), job ${PBS_JOBID:-none}, until epoch $end" | tee "$agent_dir/worker.txt"
while [[ $(date +%s) -lt $end && ! -e "$agent_dir/stop" ]]; do
    next="$(ls "$agent_dir/queue" 2>/dev/null | sort | head -n 1)"
    if [[ -z "$next" ]]; then
        sleep 5
        continue
    fi
    id="${next%.sh}"
    mv "$agent_dir/queue/$next" "$agent_dir/running/$next"
    date +%s >"$agent_dir/logs/$id.start"
    setsid bash "$agent_dir/running/$next" >"$agent_dir/logs/$id.log" 2>&1 </dev/null &
    pid=$!
    echo "$pid" >"$agent_dir/logs/$id.pid"
    while kill -0 "$pid" 2>/dev/null; do
        if [[ -e "$agent_dir/kill-$id" ]]; then
            kill -TERM -- "-$pid" 2>/dev/null
            rm -f "$agent_dir/kill-$id"
        fi
        sleep 5
    done
    wait "$pid"
    echo $? >"$agent_dir/logs/$id.exit"
    mv "$agent_dir/running/$next" "$agent_dir/done/$next"
done
echo "worker for $AGENT stopping" >>"$agent_dir/worker.txt"
